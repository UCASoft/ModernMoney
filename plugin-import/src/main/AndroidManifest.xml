<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:label="Modern Money Import Plugin"
    >
        <service android:name="com.ucasoft.modernMoney.plugin.imports.ImportService" android:exported="true">
            <intent-filter>
                <action android:name="com.ucasoft.modernMoney.PLUGIN" />
            </intent-filter>

            <meta-data
                android:name="com.ucasoft.modernMoney.PLUGIN_TYPE"
                android:value="IMPORT" />
            <meta-data
                android:name="com.ucasoft.modernMoney.PLUGIN_TITLE"
                android:value="Import from UCASoft Money" />
            <meta-data
                android:name="com.ucasoft.modernMoney.PLUGIN_DESCRIPTION"
                android:value="Import a Money JSON backup" />
        </service>
    </application>

</manifest>
